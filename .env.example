# Gemini APIキー（必須: AI整理を使用する場合）
GEMINI_API_KEY=your_api_key_here

# Vercelでprivate Blob Storeを使う場合に設定
# BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here

# 任意。未指定時は gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# 任意。未指定時は 3000
PORT=3000

# 任意。未指定時は data/app-data.json
# DATA_FILE=C:\path\to\app-data.json
